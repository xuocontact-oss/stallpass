# Copy this file to .env.local and fill in the real values.
# .env.local is never committed to git. Never share the SECRET values.

# The address the app runs at (used in login-link and reminder emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# SECRET: full database access, bypasses security rules. Server-only.
SUPABASE_SECRET_KEY=sb_secret_xxx

# EMAIL: pick ONE.
# (a) Your email account over SMTP. Works with a free Gmail and no domain:
#     Google Account → Security → 2-Step Verification ON → App passwords → create one.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# (b) Resend (needs your own domain to email other people). SECRET.
RESEND_API_KEY=
# Leave both blank to print emails in the terminal instead.
# Who emails come from. With Gmail it must be your Gmail address,
# e.g.  Stallpass <yourname@gmail.com>
EMAIL_FROM=Stallpass <onboarding@resend.dev>
# TESTING: send EVERY email here instead of to the real person/market.
# Put your own email while testing. Delete this line when you go live.
EMAIL_TEST_RECIPIENT=

# SECRET: any long random text. Protects the daily reminder job's web address.
CRON_SECRET=change-me-to-a-long-random-string

# Stripe (TEST mode while building: keys start with sk_test_ / pk_test_).
# Stripe → Developers → API keys. SECRET: server-only.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_...).
# Only needed once the app is online; locally, payments are confirmed on return.
STRIPE_WEBHOOK_SECRET=

# USDA Local Food Portal API key (free) for importing farmers markets:
# npm run import:usda -- --state=CA
USDA_API_KEY=

# Cloudflare Turnstile ("I'm not a robot" on sign-in). Free: dash.cloudflare.com → Turnstile.
# The SITE key goes here; the SECRET key goes in Supabase → Authentication → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shown on the Terms / Privacy pages and in the footer.
NEXT_PUBLIC_LEGAL_NAME=Stallpass
NEXT_PUBLIC_CONTACT_EMAIL=

# Square (vendors connect it to fill in sales reports). developer.squareup.com → your app.
# Start with SQUARE_ENVIRONMENT=sandbox and the Sandbox credentials; switch to production when live.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
# SECRET: 32+ random characters, used to encrypt stored Square tokens.
# Make one with:  openssl rand -hex 32   (never change it once vendors have connected)
TOKEN_ENCRYPTION_KEY=
