{
  "name": "stallpass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/seed.mts",
    "make-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/make-admin.mts",
    "db:sql": "f=$(ls supabase/migrations/*.sql | tail -1) && pbcopy < \"$f\" && echo \"Copied $f. Paste it into the Supabase SQL Editor and click Run.\"",
    "test:security": "node tests/security.test.mjs",
    "test:logic": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/logic.test.ts",
    "test": "npm run test:logic && npm run test:security",
    "import:usda": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/import-usda.mts",
    "db:all": "cat supabase/migrations/*.sql > supabase/all-in-one.sql && pbcopy < supabase/all-in-one.sql && echo \"Copied ALL database setup ($(ls supabase/migrations/*.sql | wc -l | tr -d ' ') files) for a brand-new project. Paste into the SQL Editor and click Run.\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
